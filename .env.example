# ── Hadoop / HDFS ────────────────────────────────────────────────────────────
HADOOP_HOME=/usr/local/hadoop
JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_LOG_PATH=/user/hadoop/logs/hdfs_logs

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ── Pipeline paths ────────────────────────────────────────────────────────────
# Relative to project root (Windows paths OK on Windows, WSL paths for Spark)
RAW_LOG_URL=https://zenodo.org/records/8196385/files/HDFS_v1.zip
LOCAL_DATA_DIR=./data/raw
OUTPUT_DIR=./outputs

# ── Parquet output (backend reads these) ─────────────────────────────────────
PARQUET_LOGS=./outputs/parquet/logs
PARQUET_STATS=./outputs/parquet/stats
PARQUET_ANOMALIES=./outputs/parquet/anomalies
PARQUET_METRICS=./outputs/parquet/metrics

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AWS (optional — leave blank to use local only) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=
S3_RAW_PREFIX=raw/
S3_OUTPUT_PREFIX=outputs/

# ── Processing options ────────────────────────────────────────────────────────
SAMPLE_MODE=true
SAMPLE_SIZE=50000
